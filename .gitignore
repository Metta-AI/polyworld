# Ignore files with no extention.
*
!*/
!*.*
!LICENSE

# Ignore hidden files, but not the license or github files.
.*
!.github/
!.github/**
!.gitignore

# Normal ignores.
*.exe
nimcache
*.pdb
*.ilk
*.out
*.replay

# Assets live in the sibling polyworld_art repo.
/data

# Project specific ignores.
*.atlas.png
experiments/terrain/quadterrain_shot.png
experiments/characters/characters_shot.png
games/gods_of_the_arena/gota_shot.png
games/gods_of_the_arena/emscripten/
games/gods_of_the_arena/profiles/
# Generated hero reports belong in polyworld-buff or tmp.
games/gods_of_the_arena/tools/hero_stats.html
games/gods_of_the_arena/tools/hero_assets/
games/call_to_adventure/shot.png
games/call_to_adventure/emscripten/
games/light_vs_dark/*.png
games/light_vs_dark/emscripten/
games/light_vs_dark/profiles/
games/heartleaf/*.png
games/heartleaf/emscripten/
tmp/
experiments/modular_chars/modular_chars_shot.png

# Coworld build outputs.
coworld/*/dist/
coworld/evidence/
!Dockerfile
!.dockerignore
coworld/**/__pycache__/

# Python conversion helpers.
__pycache__/

# Crewrift art belongs in the sibling art repository.
games/crewrift/**/*.glb
games/crewrift/**/*.blend*
games/crewrift/*_shot.png
games/crewrift/emscripten/
games/crewrift/profiles/
